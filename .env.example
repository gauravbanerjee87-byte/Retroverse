# Copy to .env in the repository root. The server loads it automatically.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
MATCH_SECONDS=120
# Vite proxies /api and /ws locally. No API key or database required.
